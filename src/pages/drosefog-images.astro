---
import '../styles/global.css';

const images = [
	'FOG-ROSE-EVENT-3.jpg',
	'FOG-ROSE-EVENT-10.jpg',
	'FOG-ROSE-EVENT-10 (1).jpg',
	'FOG-ROSE-EVENT-43.jpg',
	'FOG-ROSE-EVENT-47.jpg',
	'adidas-FOG-DRose-120425-3.jpg',
	'adidas-FOG-DRose-120425-6.jpg',
	'adidas-FOG-DRose-120425-8.jpg',
	'adidas-FOG-DRose-120425-14.jpg',
	'adidas-FOG-DRose-120425-16.jpg',
	'adidas-FOG-DRose-Step&Repeat-120425-49.jpg',
	'fog-1.jpg',
	'bg-2.jpg',
	'Pasted Graphic.png',
	'Pasted Graphic 1.png',
	'Pasted Graphic 3.png',
	'Pasted Graphic 4.png'
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Drose/FOG Image Reference</title>
	</head>
	<body class="font-sans bg-[#fdfffd] p-6">
		<header class="max-w-[1400px] mx-auto mb-8">
			<h1 class="text-[#010101] text-3xl font-bold mb-2">adidas FOG / D Rose — Image Library</h1>
			<p class="text-gray-600">Reference gallery. Each image shows its full uncropped view with filename below.</p>
		</header>
		<main class="max-w-[1400px] mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
			{images.map((filename) => (
				<div class="flex flex-col gap-2 bg-[#f4f4f0] rounded-2xl p-4">
					<div class="w-full aspect-[4/3] bg-black/5 rounded-xl overflow-hidden flex items-center justify-center">
						<img
							src={`/images/case-studies/drosefog/${filename}`}
							alt={filename}
							class="w-full h-full object-contain"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<code class="text-xs text-[#010101] font-mono break-all select-all">{filename}</code>
				</div>
			))}
		</main>
	</body>
</html>
