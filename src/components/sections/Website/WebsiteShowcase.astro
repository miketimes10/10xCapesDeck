---
// Desktop screenshots of website builds, one tile per site.
// Images are local files in public/images/websites, so plain <img> tags are used.

export interface SiteItem {
	name: string;
	desktop: string;
}

export interface Props {
	sites: SiteItem[];
	id?: string;
}

const { sites, id } = Astro.props;
---

<section id={id} class="w-full h-dvh max-h-dvh p-2 md:p-4 lg:p-8 snap-start snap-always flex overflow-hidden box-border">
	<div class="w-full flex-1 min-h-0 flex flex-col md:flex-row items-center justify-center gap-2 md:gap-4 lg:gap-8">
		{sites.map((site) => (
			<div class="website-tile overflow-hidden lg:rounded-[40px] rounded-3xl border border-gray-300">
				<img
					src={site.desktop}
					alt={`${site.name} website`}
					class="w-full h-full object-cover object-left-top"
					loading="lazy"
				/>
			</div>
		))}
	</div>
</section>

<style>
	/* 16:10 tiles: stacked on phones, side by side from tablet up */
	.website-tile {
		aspect-ratio: 16 / 10;
		width: 100%;
	}
	@media (min-width: 768px) {
		.website-tile {
			width: calc(50% - 0.5rem);
		}
	}
	@media (min-width: 1024px) {
		.website-tile {
			width: calc(50% - 1rem);
		}
	}
</style>
